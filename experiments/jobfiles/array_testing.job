#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=ArrayJob
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9


#SBATCH --time=03:00:00
#SBATCH --array=1-20 # 420 jobs, 1 for each line of hparam file
#SBATCH --output=../slurm/slurm_array_testing_%A_%a.out

module purge
module load 2023
module load Anaconda3/2023.07-2

# Your job starts in the directory where you call sbatch
cd ../../src

# Activate your environment
source activate seater

HPARAMS_FILE=~/BSARec/experiments/jobfiles/hparams_tune_Fourierrec.txt

# Run your code
srun python main.py $(head -$SLURM_ARRAY_TASK_ID $HPARAMS_FILE | tail -1)
